{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/book-repository-template/contracts/v1/record-review-state.schema.json",
  "title": "Per-record review and completeness state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordId",
        "revision",
        "completeness",
        "review"
      ],
      "properties": {
        "recordId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "completeness": {
          "$ref": "#/$defs/completeness"
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceLinkage",
        "metadata",
        "correctionState"
      ],
      "properties": {
        "sourceLinkage": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "metadata": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "correctionState": {
          "enum": [
            "current",
            "corrected",
            "superseded"
          ]
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "confidence",
        "reviewerId",
        "reviewedAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "unreviewed",
            "in-review",
            "human-reviewed",
            "corrected"
          ]
        },
        "confidence": {
          "enum": [
            "unknown",
            "low",
            "medium",
            "high"
          ]
        },
        "reviewerId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
