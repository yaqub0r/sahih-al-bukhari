{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/book-repository-template/contracts/v1/release-pointer.schema.json",
  "title": "Mutable consumer release pointer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pointerId",
    "activeReleaseId",
    "latestReleaseId",
    "reasonCode",
    "rollbackFromReleaseId",
    "updatedAt",
    "updatedBy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "pointerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "activeReleaseId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "latestReleaseId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "reasonCode": {
      "enum": [
        "normal-advance",
        "rollback"
      ]
    },
    "rollbackFromReleaseId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedBy": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    }
  }
}
