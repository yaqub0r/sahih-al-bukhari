{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/book-repository-template/contracts/v1/source-provenance.schema.json",
  "title": "Source provenance and rights register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "classification",
        "sourceType",
        "locator",
        "fingerprint",
        "rights"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "sourceType": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "rights": {
          "$ref": "#/$defs/rights"
        }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "value"
      ],
      "properties": {
        "scheme": {
          "enum": [
            "uri",
            "opaque",
            "withheld"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registryEntryId",
        "status",
        "permittedScopes",
        "decidedBy",
        "decidedAt"
      ],
      "properties": {
        "registryEntryId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "status": {
          "enum": [
            "unknown",
            "under-review",
            "approved",
            "restricted",
            "expired"
          ]
        },
        "permittedScopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "metadata",
              "derived-facts",
              "quotation",
              "full-text",
              "images"
            ]
          }
        },
        "decidedBy": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "decidedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
