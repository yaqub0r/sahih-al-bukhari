{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/book-repository-template/contracts/v1/release-closure.schema.json",
  "title": "Immutable public release closure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "releaseSequence",
    "previousReleaseId",
    "createdAt",
    "producerId",
    "states",
    "consumerCompatibility",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "releaseSequence": {
      "type": "integer",
      "minimum": 1
    },
    "previousReleaseId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "producerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "states": {
      "$ref": "#/$defs/states"
    },
    "consumerCompatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "states": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicRelease",
        "canonicalPromotion",
        "promotedBy",
        "promotedAt"
      ],
      "properties": {
        "publicRelease": {
          "enum": [
            "published",
            "withdrawn"
          ]
        },
        "canonicalPromotion": {
          "enum": [
            "not-used",
            "candidate",
            "promoted",
            "reverted"
          ]
        },
        "promotedBy": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "promotedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractMajor",
        "minimumConsumerMajor",
        "maximumConsumerMajor"
      ],
      "properties": {
        "contractMajor": {
          "const": 1
        },
        "minimumConsumerMajor": {
          "type": "integer",
          "minimum": 1
        },
        "maximumConsumerMajor": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mediaType",
        "schemaVersion",
        "sha256",
        "canonicalBytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/-]*\\.json$"
        },
        "mediaType": {
          "const": "application/json"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "canonicalBytes": {
          "type": "integer",
          "minimum": 2
        }
      }
    }
  }
}
