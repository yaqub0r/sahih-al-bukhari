{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/book-repository-template/contracts/v1/project-config.schema.json",
  "title": "Project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "identityRegistry",
    "classificationPolicy",
    "releasePolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "identityRegistry": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identity"
      }
    },
    "classificationPolicy": {
      "$ref": "#/$defs/classificationPolicy"
    },
    "releasePolicy": {
      "$ref": "#/$defs/releasePolicy"
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "roles"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "producer",
              "reviewer",
              "promoter"
            ]
          }
        }
      }
    },
    "classificationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicValues",
        "nonPublicValues"
      ],
      "properties": {
        "publicValues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "nonPublicValues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "releasePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowPublicWorkingRelease",
        "requireHumanReviewForRelease",
        "canonicalPromotionMode"
      ],
      "properties": {
        "allowPublicWorkingRelease": {
          "type": "boolean"
        },
        "requireHumanReviewForRelease": {
          "type": "boolean"
        },
        "canonicalPromotionMode": {
          "enum": [
            "unused",
            "optional",
            "required"
          ]
        }
      }
    }
  }
}
